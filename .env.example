# Default: local Ollama. No paid API key.
# fake = offline provider for tests and CI (no model, no network).
# openai is deprecated. Do not set it, and do not put a paid API key here.
PROVIDER=ollama

# Deprecated paid API. Ignored when PROVIDER=ollama or PROVIDER=fake.
# A normal run never sends this key. Leave it empty.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama (default provider).
# Chat model llama3.2:3b runs on a typical laptop.
# On a machine with 16 GB of RAM you can use llama3.1:8b instead:
#   ollama pull llama3.1:8b
#   OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Storage
DATA_DIR=data

# Retrieval / chunking
CHUNK_SIZE=400
CHUNK_OVERLAP=80
TOP_K=4
# Cosine similarity below this means "not in the documents". Leave empty to use the
# provider default (ollama=0.45, fake=0.15). Tune with scripts/eval.py.
# The deprecated openai default was 0.30.
MIN_SCORE=

# Uploads
MAX_UPLOAD_MB=10

# Logging
LOG_LEVEL=INFO
